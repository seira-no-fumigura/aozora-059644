   "lb": [],
   "form": "prose"
  },
  {
   "id": "aozora-059644-000080",
   "pid": "",
   "pages": [],
   "no": 80,
   "vol": "",
   "kotobagaki": "",
   "author": "",
   "text": "一同「くわぬくわぬ」",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "aozora-059644-000081",
   "pid": "",
   "pages": [],
   "no": 81,
   "vol": "",
   "kotobagaki": "",
   "author": "",
   "text": "手　「さても桑名の焼蛤、拙者がこうして手で蛤を、もってこっちの手がのびて、つまんで口へ入れるの道理、",
   "sachu": "",
   "poems": [],
